# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-your-token-here

# Optional: target chat id. If left empty, the bot captures it
# automatically the first time you send /start to it.
TELEGRAM_CHAT_ID=

# --- Optional tuning ---
PRODUCT=BTCUSDT            # Binance trading symbol
INTERVAL=5m               # Binance kline interval
GRANULARITY=300           # candle size in seconds (300 = 5 minutes)
KLINES_LIMIT=200          # how many candles to pull for the indicators
LEAD_SECONDS=60           # send the prediction this many seconds before the candle opens
TICK_SECONDS=3            # how often the scheduler checks the clock
DISPLAY_TZ=Asia/Tehran    # timezone for the HH:MM shown in the message
PERSIAN_DIGITS=1          # 1 = Persian digits (۱۲:۰۵), 0 = Latin (12:05)

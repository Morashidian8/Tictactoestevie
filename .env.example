# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-your-token-here

# Optional: target chat id. If left empty, the bot captures it
# automatically the first time you send /start to it.
TELEGRAM_CHAT_ID=

# --- Optional tuning ---
PRODUCT=BTCUSDT            # Binance trading symbol
INTERVAL=5m               # Binance kline interval
GRANULARITY=300           # candle size in seconds (300 = 5 minutes)
ALTERNATION_THRESHOLD=5   # alert when this many candles alternate in a row
POLL_SECONDS=20           # how often to poll Binance

# --- Polymarket auto-trading bot (trade_bot.py) ---
DRY_RUN=true              # KEEP true until you trust the strategy. false = real money!
STRATEGY=alternation      # alternation | streak (see strategies.py)
STRATEGY_MODE=follow      # follow | fade
STAKE_USDC=5              # USDC spent per trade
MAX_ENTRY_PRICE=0.60      # never buy an outcome priced above this
DAILY_LOSS_LIMIT_USDC=20  # stop trading for the day after losing this much
MAX_CONSECUTIVE_LOSSES=4  # stop trading for the day after this many losses in a row
ENTRY_WINDOW_SECONDS=90   # only enter during the first N seconds of a window

# Live trading credentials (only needed when DRY_RUN=false).
# Export the key from Polymarket: Profile -> Settings -> Export Private Key.
POLY_PRIVATE_KEY=
# Your Polymarket deposit/proxy address (shown on the deposit page).
POLY_FUNDER=
# 1 = account created with email/Magic, 2 = browser wallet, 0 = direct EOA
POLY_SIGNATURE_TYPE=1

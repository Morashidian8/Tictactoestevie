# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-your-token-here

# Optional: target chat id. If left empty, the bot captures it
# automatically the first time you send /start to it.
TELEGRAM_CHAT_ID=

# --- Optional tuning ---
PRODUCT=BTC-USD
GRANULARITY=300            # candle size in seconds (300 = 5 minutes)
ALTERNATION_THRESHOLD=6    # alert when this many candles alternate in a row
POLL_SECONDS=20            # how often to poll Coinbase

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=123456:ABC-your-token-here

# Optional: target chat id. If left empty, the bot captures it
# automatically the first time you send /start to it.
TELEGRAM_CHAT_ID=

# --- Optional tuning ---
PRODUCT=BTCUSDT            # Binance trading symbol
INTERVAL=5m               # Binance kline interval
GRANULARITY=300           # candle size in seconds (300 = 5 minutes)
ALTERNATION_THRESHOLD=5   # alert when this many candles alternate in a row
POLL_SECONDS=20           # how often to poll Binance

# --- Notification straight to the phone, without Telegram ---
# Install the "ntfy" app (Play Store or F-Droid), subscribe it to the SAME
# topic string, and every signal arrives as a normal Android notification.
# Pick something long and unguessable: a topic is public to anyone who knows it.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh      # or your own server

# Sound made by the phone itself: beep (default) | full (spoken) | off
LOCAL_ALERT=beep

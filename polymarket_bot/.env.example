# Copy to .env and fill in. .env is git-ignored and must stay that way.
#
# Nothing in Phase 1 needs any of these: the collectors read only public
# market data. They are listed now so that the day an executor exists, the
# key never has a reason to appear in a YAML file or a command line.

# ---- Polymarket credentials (Phase 9+; leave empty until then) -------------
# The signing key for CLOB orders. A hot key on a trading box should hold only
# what you are willing to lose.
POLYMARKET_PRIVATE_KEY=
# L2 API credentials, derived from the private key by Polymarket's own client.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=

# ---- Optional alerting (Phase 21) -----------------------------------------
# Never send a key, an address, or a balance through this channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Runtime overrides -----------------------------------------------------
# record | backtest | paper | live   (only `record` is implemented)
BOT_MODE=record
LOG_LEVEL=INFO
RECORDER_ENABLED=false
RECORDER_ROOT=data/raw

# Endpoint overrides, for pointing at a mock or a replay server in tests.
# POLYMARKET_WS_URL=
# GAMMA_URL=
# CLOB_URL=

# ---- Live trading ----------------------------------------------------------
# Deliberately absent. Live trading does not exist in this codebase yet, and
# when it does it will need an explicit LIVE_TRADING=true plus hard size and
# loss limits — not a mode string.
